# Active AI provider (server-only, never exposed to the client)
OPENAI_API_KEY=

# Optional: only needed if src/lib/ai/index.ts is switched back to
# GeminiProvider (kept in the codebase, currently inactive).
GEMINI_API_KEY=

# Supabase - anon/publishable credentials, used by both browser and server
# clients. Safe to expose client-side; all access is enforced by RLS.
# No service-role key is used in this codebase — see src/lib/supabase/server.ts.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
